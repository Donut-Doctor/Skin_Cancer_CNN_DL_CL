{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"gpu","dataSources":[{"sourceType":"datasetVersion","sourceId":104884}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/sumanpal03/skin-cancer-cnn-dl-cl?scriptVersionId=340811854\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"markdown","source":"# Skin Cancer Detection\n**DR. BC ROY ENGINEERING COLLEGE, DURGAPUR | MCA | Major Project CA-482**\n\nSuman Pal\n","metadata":{}},{"cell_type":"code","source":"%matplotlib inline\nimport os, itertools, warnings, cv2\nwarnings.filterwarnings('ignore')\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom glob import glob\nfrom PIL import Image\nfrom multiprocessing.pool import ThreadPool\nnp.random.seed(42)\n\nimport tensorflow as tf\nprint('TensorFlow:', tf.__version__)\nprint('GPUs:', tf.config.list_physical_devices('GPU'))\n\nfrom tensorflow.keras.utils import to_categorical\nfrom tensorflow.keras.models import Model\nfrom tensorflow.keras.layers import Dense, Dropout, GlobalAveragePooling2D, BatchNormalization\nfrom tensorflow.keras.applications import ResNet50V2\nfrom tensorflow.keras.applications.resnet_v2 import preprocess_input\nfrom tensorflow.keras.optimizers import Adam\nfrom tensorflow.keras.callbacks import ReduceLROnPlateau, EarlyStopping, ModelCheckpoint\nfrom tensorflow.keras.regularizers import l2\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.utils.class_weight import compute_class_weight\nfrom sklearn.metrics import confusion_matrix, classification_report\nprint('All imports OK.')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:00:51.992994Z","iopub.execute_input":"2026-05-20T06:00:51.993296Z","iopub.status.idle":"2026-05-20T06:01:19.537698Z","shell.execute_reply.started":"2026-05-20T06:00:51.993259Z","shell.execute_reply":"2026-05-20T06:01:19.536896Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 1 — Load Dataset","metadata":{}},{"cell_type":"code","source":"base_dir = os.path.join('..', 'input')\nimageid_path_dict = {\n    os.path.splitext(os.path.basename(x))[0]: x\n    for x in glob(os.path.join(base_dir, '*', '*.jpg'))\n}\nprint('Total images found:', len(imageid_path_dict))\n\nlesion_type_dict = {\n    'nv':    'Melanocytic nevi',\n    'mel':   'Melanoma',\n    'bkl':   'Benign keratosis-like lesions',\n    'bcc':   'Basal cell carcinoma',\n    'akiec': 'Actinic keratoses',\n    'vasc':  'Vascular lesions',\n    'df':    'Dermatofibroma'\n}\n\nskin_df = pd.read_csv(os.path.join(base_dir, 'HAM10000_metadata.csv'))\nskin_df['path']          = skin_df['image_id'].map(imageid_path_dict.get)\nskin_df['cell_type']     = skin_df['dx'].map(lesion_type_dict.get)\nskin_df['cell_type_idx'] = pd.Categorical(skin_df['cell_type']).codes\nskin_df['age'].fillna(skin_df['age'].mean(), inplace=True)\nprint('Class distribution:')\nprint(skin_df['cell_type'].value_counts())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:01:19.539315Z","iopub.execute_input":"2026-05-20T06:01:19.539736Z","iopub.status.idle":"2026-05-20T06:01:20.122783Z","shell.execute_reply.started":"2026-05-20T06:01:19.539711Z","shell.execute_reply":"2026-05-20T06:01:20.121816Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 2 — EDA","metadata":{}},{"cell_type":"code","source":"fig, axes = plt.subplots(1, 2, figsize=(14, 4))\ncolors = ['#e74c3c' if c in ['Melanoma','Basal cell carcinoma','Actinic keratoses']\n          else '#f39c12' if c == 'Vascular lesions' else '#2ecc71'\n          for c in skin_df['cell_type'].value_counts().index]\nskin_df['cell_type'].value_counts().plot(kind='bar', ax=axes[0], color=colors, edgecolor='white')\naxes[0].set_title('Class Distribution (Red=High Risk)')\naxes[0].tick_params(axis='x', rotation=35)\nskin_df['age'].hist(bins=40, ax=axes[1], color='steelblue', edgecolor='white')\naxes[1].set_title('Age Distribution')\nplt.tight_layout(); plt.savefig('eda.png', dpi=120); plt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:01:20.123972Z","iopub.execute_input":"2026-05-20T06:01:20.124329Z","iopub.status.idle":"2026-05-20T06:01:20.72801Z","shell.execute_reply.started":"2026-05-20T06:01:20.124296Z","shell.execute_reply":"2026-05-20T06:01:20.727294Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 3 — Preprocessing (Hair Removal + CLAHE)","metadata":{}},{"cell_type":"code","source":"IMG_SIZE = 224\n\ndef remove_hair(img):\n    try:\n        gray   = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)\n        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (9, 9))\n        bhat   = cv2.morphologyEx(gray, cv2.MORPH_BLACKHAT, kernel)\n        _, th  = cv2.threshold(bhat, 10, 255, cv2.THRESH_BINARY)\n        return cv2.inpaint(img, th, 1, cv2.INPAINT_TELEA)\n    except: return img\n\ndef apply_clahe(img):\n    try:\n        lab     = cv2.cvtColor(img, cv2.COLOR_RGB2LAB)\n        l, a, b = cv2.split(lab)\n        clahe   = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))\n        return cv2.cvtColor(cv2.merge([clahe.apply(l), a, b]), cv2.COLOR_LAB2RGB)\n    except: return img\n\ndef load_and_preprocess(path):\n    try:\n        img = np.asarray(Image.open(path).resize((IMG_SIZE, IMG_SIZE)).convert('RGB'))\n        return apply_clahe(remove_hair(img))\n    except: return np.zeros((IMG_SIZE, IMG_SIZE, 3), dtype=np.uint8)\n\nsample_paths = skin_df['path'].sample(3, random_state=42).tolist()\nfig, axes = plt.subplots(3, 3, figsize=(10, 10))\nfor i, path in enumerate(sample_paths):\n    raw = np.asarray(Image.open(path).resize((IMG_SIZE, IMG_SIZE)).convert('RGB'))\n    for ax, im, t in zip(axes[i],\n                         [raw, remove_hair(raw), apply_clahe(remove_hair(raw))],\n                         ['Original', 'Hair Removed', 'CLAHE']):\n        ax.imshow(im); ax.set_title(t, fontsize=9); ax.axis('off')\nplt.suptitle('Preprocessing Pipeline', fontsize=12, fontweight='bold')\nplt.tight_layout(); plt.savefig('preprocessing.png', dpi=120); plt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:01:20.728865Z","iopub.execute_input":"2026-05-20T06:01:20.729263Z","iopub.status.idle":"2026-05-20T06:01:22.870745Z","shell.execute_reply.started":"2026-05-20T06:01:20.72924Z","shell.execute_reply":"2026-05-20T06:01:22.869814Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 4 — Load All Images","metadata":{}},{"cell_type":"code","source":"print('Loading {} images with 8 threads...'.format(len(skin_df)))\nwith ThreadPool(8) as pool:\n    images = pool.map(load_and_preprocess, skin_df['path'].tolist())\nskin_df['image'] = images\nprint('Done! Shape:', skin_df['image'].iloc[0].shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:01:22.871783Z","iopub.execute_input":"2026-05-20T06:01:22.872159Z","iopub.status.idle":"2026-05-20T06:02:30.104833Z","shell.execute_reply.started":"2026-05-20T06:01:22.872135Z","shell.execute_reply":"2026-05-20T06:02:30.104002Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 5 — Oversample Minority Classes\n> Increased target to 1500 for worst-performing classes (vasc, bkl, akiec).","metadata":{}},{"cell_type":"code","source":"# Boosted targets based on v5 classification report\n# Vascular lesions F1=0.56 → boost to 2000\n# BKL F1=0.78, Melanoma F1=0.88 → boost to 1500\nboost_2000 = ['Vascular lesions']\nboost_1500 = ['Benign keratosis-like lesions', 'Melanoma']\n\nbalanced = []\nfor idx in sorted(skin_df['cell_type_idx'].unique()):\n    sub  = skin_df[skin_df['cell_type_idx'] == idx]\n    n    = len(sub)\n    name = sub['cell_type'].iloc[0]\n    if name in boost_2000:\n        target = 2000\n    elif name in boost_1500:\n        target = 1500\n    else:\n        target = 1000\n    if n < target:\n        times  = target // n\n        remain = target % n\n        over   = pd.concat([sub]*times + [sub.sample(remain, random_state=42)],\n                           ignore_index=True)\n        balanced.append(over)\n        print('Class {:d} ({:<35s}): {:4d} -> {:4d}'.format(idx, name, n, len(over)))\n    else:\n        balanced.append(sub)\n        print('Class {:d} ({:<35s}): {:4d} (unchanged)'.format(idx, name, n))\n\nskin_df_bal = pd.concat(balanced, ignore_index=True).sample(frac=1, random_state=42)\nprint('\\nBalanced total:', len(skin_df_bal))\nprint(skin_df_bal['cell_type'].value_counts())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:02:30.10603Z","iopub.execute_input":"2026-05-20T06:02:30.106451Z","iopub.status.idle":"2026-05-20T06:02:30.139799Z","shell.execute_reply.started":"2026-05-20T06:02:30.106388Z","shell.execute_reply":"2026-05-20T06:02:30.13914Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 6 — Split & Normalize","metadata":{}},{"cell_type":"code","source":"features = skin_df_bal.drop(columns=['cell_type_idx'])\ntarget   = skin_df_bal['cell_type_idx']\n\nx_tr_o, x_test_o, y_tr_o, y_test_o = train_test_split(\n    features, target, test_size=0.20, random_state=42, stratify=target\n)\nx_train_raw = np.asarray(x_tr_o['image'].tolist()).astype('float32')\nx_test_raw  = np.asarray(x_test_o['image'].tolist()).astype('float32')\ny_train     = to_categorical(y_tr_o,   num_classes=7)\ny_test      = to_categorical(y_test_o, num_classes=7)\n\nx_train_raw, x_val_raw, y_train, y_validate = train_test_split(\n    x_train_raw, y_train, test_size=0.10, random_state=42\n)\n\nx_val_scaled  = preprocess_input(x_val_raw.copy())\nx_test_scaled = preprocess_input(x_test_raw.copy())\n\nprint('Train    :', x_train_raw.shape)\nprint('Validate :', x_val_raw.shape)\nprint('Test     :', x_test_raw.shape)\nprint('Val range: [{:.1f}, {:.1f}]'.format(x_val_scaled.min(), x_val_scaled.max()))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:02:30.141965Z","iopub.execute_input":"2026-05-20T06:02:30.142263Z","iopub.status.idle":"2026-05-20T06:02:36.394655Z","shell.execute_reply.started":"2026-05-20T06:02:30.14224Z","shell.execute_reply":"2026-05-20T06:02:36.393964Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 7 — Class Weights","metadata":{}},{"cell_type":"code","source":"cw = compute_class_weight('balanced', classes=np.unique(y_tr_o), y=y_tr_o)\nclass_weight_dict = dict(enumerate(cw))\nprint('Class weights:')\nfor k, v in class_weight_dict.items():\n    print('  [{:d}] {:<35s}: {:.4f}'.format(k, list(lesion_type_dict.values())[k], v))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:02:36.395639Z","iopub.execute_input":"2026-05-20T06:02:36.39643Z","iopub.status.idle":"2026-05-20T06:02:36.405628Z","shell.execute_reply.started":"2026-05-20T06:02:36.396404Z","shell.execute_reply":"2026-05-20T06:02:36.404792Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 8 — tf.data Pipeline with .repeat()","metadata":{}},{"cell_type":"code","source":"BATCH_SIZE = 32\nAUTOTUNE   = tf.data.AUTOTUNE\n\n@tf.function\ndef augment_fn(image, label):\n    image = tf.cast(image, tf.float32)\n    image = (image / 127.5) - 1.0          # ResNet50V2 normalization\n    image = tf.image.random_flip_left_right(image)\n    image = tf.image.random_flip_up_down(image)\n    k     = tf.random.uniform([], 0, 4, dtype=tf.int32)\n    image = tf.image.rot90(image, k=k)\n    image = tf.image.random_brightness(image, max_delta=0.15)\n    image = tf.image.random_contrast(image, lower=0.85, upper=1.15)\n    image = tf.clip_by_value(image, -1.0, 1.0)\n    return image, label\n\n# .repeat() + steps_per_epoch = guaranteed full epoch every time\ntrain_ds = (\n    tf.data.Dataset.from_tensor_slices((x_train_raw, y_train))\n    .shuffle(buffer_size=len(x_train_raw), seed=42, reshuffle_each_iteration=True)\n    .map(augment_fn, num_parallel_calls=AUTOTUNE)\n    .batch(BATCH_SIZE)\n    .repeat()                               # KEY FIX: never exhausts\n    .prefetch(AUTOTUNE)\n)\n\nSTEPS = len(x_train_raw) // BATCH_SIZE\nprint('Pipeline ready with .repeat() — no more alternating epoch bug')\nprint('Steps per epoch :', STEPS)\nprint('Total train imgs:', len(x_train_raw))\n\nfor imgs, labels in train_ds.take(1):\n    print('Batch shape     :', imgs.shape)\n    print('Pixel range     : [{:.2f}, {:.2f}]'.format(\n        float(tf.reduce_min(imgs)), float(tf.reduce_max(imgs))))\nprint('Pipeline verified OK.')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:02:36.406758Z","iopub.execute_input":"2026-05-20T06:02:36.407148Z","iopub.status.idle":"2026-05-20T06:02:58.002208Z","shell.execute_reply.started":"2026-05-20T06:02:36.407097Z","shell.execute_reply":"2026-05-20T06:02:58.001356Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 9 — Build Model (ResNet50V2)","metadata":{}},{"cell_type":"code","source":"NUM_CLASSES = 7\nINPUT_SHAPE = (IMG_SIZE, IMG_SIZE, 3)\n\nbase_model = ResNet50V2(\n    weights='imagenet', include_top=False, input_shape=INPUT_SHAPE\n)\nbase_model.trainable = False\n\n# Increased dropout to reduce overfitting (v5 had 8.7% train-val gap)\nx      = base_model.output\nx      = GlobalAveragePooling2D()(x)\nx      = BatchNormalization()(x)\nx      = Dropout(0.6)(x)  # increased from 0.5\nx      = Dense(512, activation='relu', kernel_regularizer=l2(2e-4))(x)  # stronger L2\nx      = BatchNormalization()(x)\nx      = Dropout(0.5)(x)  # increased from 0.4\nx      = Dense(256, activation='relu', kernel_regularizer=l2(2e-4))(x)\nx      = BatchNormalization()(x)\nx      = Dropout(0.4)(x)  # increased from 0.3\noutput = Dense(NUM_CLASSES, activation='softmax')(x)\n\nmodel = Model(inputs=base_model.input, outputs=output)\n\ntotal     = int(np.sum([np.prod(w.shape) for w in model.weights]))\ntrainable = int(np.sum([np.prod(w.shape) for w in model.trainable_weights]))\nprint('Backbone     : ResNet50V2 (ImageNet)')\nprint('Dropout      : 0.6 / 0.5 / 0.4  (increased to fight overfitting)')\nprint('L2 reg       : 2e-4 (stronger than v5)')\nprint('Total params : {:,}'.format(total))\nprint('Trainable    : {:,} (head only — Phase 1)'.format(trainable))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:02:58.003262Z","iopub.execute_input":"2026-05-20T06:02:58.003556Z","iopub.status.idle":"2026-05-20T06:03:00.711842Z","shell.execute_reply.started":"2026-05-20T06:02:58.003534Z","shell.execute_reply":"2026-05-20T06:03:00.711195Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 10 — Callbacks","metadata":{}},{"cell_type":"code","source":"def get_callbacks(path, patience_es=12, patience_lr=5):\n    return [\n        EarlyStopping(\n            monitor='val_accuracy', patience=patience_es,\n            restore_best_weights=True, mode='max', verbose=1\n        ),\n        ReduceLROnPlateau(\n            monitor='val_loss', factor=0.5,\n            patience=patience_lr, min_lr=1e-9, verbose=1\n        ),\n        ModelCheckpoint(\n            path, monitor='val_accuracy',\n            save_best_only=True, mode='max', verbose=1\n        )\n    ]\nprint('Callbacks ready.')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:03:00.712673Z","iopub.execute_input":"2026-05-20T06:03:00.713015Z","iopub.status.idle":"2026-05-20T06:03:00.718064
count":5},{"cell_type":"markdown","source":"## Step 5 — Oversample Minority Classes\n> Increased target to 1500 for worst-performing classes (vasc, bkl, akiec).","metadata":{}},{"cell_type":"code","source":"# Boosted targets based on v5 classification report\n# Vascular lesions F1=0.56 → boost to 2000\n# BKL F1=0.78, Melanoma F1=0.88 → boost to 1500\nboost_2000 = ['Vascular lesions']\nboost_1500 = ['Benign keratosis-like lesions', 'Melanoma']\n\nbalanced = []\nfor idx in sorted(skin_df['cell_type_idx'].unique()):\n    sub  = skin_df[skin_df['cell_type_idx'] == idx]\n    n    = len(sub)\n    name = sub['cell_type'].iloc[0]\n    if name in boost_2000:\n        target = 2000\n    elif name in boost_1500:\n        target = 1500\n    else:\n        target = 1000\n    if n < target:\n        times  = target // n\n        remain = target % n\n        over   = pd.concat([sub]*times + [sub.sample(remain, random_state=42)],\n                           ignore_index=True)\n        balanced.append(over)\n        print('Class {:d} ({:<35s}): {:4d} -> {:4d}'.format(idx, name, n, len(over)))\n    else:\n        balanced.append(sub)\n        print('Class {:d} ({:<35s}): {:4d} (unchanged)'.format(idx, name, n))\n\nskin_df_bal = pd.concat(balanced, ignore_index=True).sample(frac=1, random_state=42)\nprint('\\nBalanced total:', len(skin_df_bal))\nprint(skin_df_bal['cell_type'].value_counts())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-20T06:02:30.10603Z","iopub.execute_input":"2026-05-20T06:02:30.106451Z","iopub.status.idle":"2026-05-20T06:02:30.139799Z","shell.execute_reply.started":"2026-05-20T06:02:30.106388Z","shell.execute_reply":"2026-05-20T06:02:30.13914Z"}},"outputs":[{"name":"stdout","text":"Class 0 (Actinic keratoses                  ):  327 -> 1000\nClass 1 (Basal cell carcinoma               ):  514 -> 1000\nClass 2 (Benign keratosis-like lesions      ): 1099 -> 1500\nClass 3 (Dermatofibroma                     ):  115 -> 1000\nClass 4 (Melanocy
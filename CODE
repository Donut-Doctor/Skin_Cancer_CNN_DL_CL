## Step 3 — Preprocessing (Hair Removal + CLAHE)
IMG_SIZE = 224

def remove_hair(img):
    try:
        gray   = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)
        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (9, 9))
        bhat   = cv2.morphologyEx(gray, cv2.MORPH_BLACKHAT, kernel)
        _, th  = cv2.threshold(bhat, 10, 255, cv2.THRESH_BINARY)
        return cv2.inpaint(img, th, 1, cv2.INPAINT_TELEA)
    except: return img

def apply_clahe(img):
    try:
        lab     = cv2.cvtColor(img, cv2.COLOR_RGB2LAB)
        l, a, b = cv2.split(lab)
        clahe   = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
        return cv2.cvtColor(cv2.merge([clahe.apply(l), a, b]), cv2.COLOR_LAB2RGB)
    except: return img

def load_and_preprocess(path):
    try:
        img = np.asarray(Image.open(path).resize((IMG_SIZE, IMG_SIZE)).convert('RGB'))
        return apply_clahe(remove_hair(img))
    except: return np.zeros((IMG_SIZE, IMG_SIZE, 3), dtype=np.uint8)

sample_paths = skin_df['path'].sample(3, random_state=42).tolist()
fig, axes = plt.subplots(3, 3, figsize=(10, 10))
for i, path in enumerate(sample_paths):
    raw = np.asarray(Image.open(path).resize((IMG_SIZE, IMG_SIZE)).convert('RGB'))
    for ax, im, t in zip(axes[i],
                         [raw, remove_hair(raw), apply_clahe(remove_hair(raw))],
                         ['Original', 'Hair Removed', 'CLAHE']):
        ax.imshow(im); ax.set_title(t, fontsize=9); ax.axis('off')
plt.suptitle('Preprocessing Pipeline', fontsize=12, fontweight='bold')
plt.tight_layout(); plt.savefig('preprocessing.png', dpi=120); plt.show()

## Step 4 — Load All Images
print('Loading {} images with 8 threads...'.format(len(skin_df)))
with ThreadPool(8) as pool:
    images = pool.map(load_and_preprocess, skin_df['path'].tolist())
skin_df['image'] = images
print('Done! Shape:', skin_df['image'].iloc[0].shape)

## Step 5 — Oversample Minority Classes
> Increased target to 1500 for worst-performing classes (vasc, bkl, akiec).
# Boosted targets based on v5 classification report
# Vascular lesions F1=0.56 → boost to 2000
# BKL F1=0.78, Melanoma F1=0.88 → boost to 1500
boost_2000 = ['Vascular lesions']
boost_1500 = ['Benign keratosis-like lesions', 'Melanoma']

balanced = []
for idx in sorted(skin_df['cell_type_idx'].unique()):
    sub  = skin_df[skin_df['cell_type_idx'] == idx]
    n    = len(sub)
    name = sub['cell_type'].iloc[0]
    if name in boost_2000:
        target = 2000
    elif name in boost_1500:
        target = 1500
    else:
        target = 1000
    if n < target:
        times  = target // n
        remain = target % n
        over   = pd.concat([sub]*times + [sub.sample(remain, random_state=42)],
                           ignore_index=True)
        balanced.append(over)
        print('Class {:d} ({:<35s}): {:4d} -> {:4d}'.format(idx, name, n, len(over)))
    else:
        balanced.append(sub)
        print('Class {:d} ({:<35s}): {:4d} (unchanged)'.format(idx, name, n))

skin_df_bal = pd.concat(balanced, ignore_index=True).sample(frac=1, random_state=42)
print('\nBalanced total:', len(skin_df_bal))
print(skin_df_bal['cell_type'].value_counts())

## Step 6 — Split & Normalize
features = skin_df_bal.drop(columns=['cell_type_idx'])
target   = skin_df_bal['cell_type_idx']

x_tr_o, x_test_o, y_tr_o, y_test_o = train_test_split(
    features, target, test_size=0.20, random_state=42, stratify=target
)
x_train_raw = np.asarray(x_tr_o['image'].tolist()).astype('float32')
x_test_raw  = np.asarray(x_test_o['image'].tolist()).astype('float32')
y_train     = to_categorical(y_tr_o,   num_classes=7)
y_test      = to_categorical(y_test_o, num_classes=7)

x_train_raw, x_val_raw, y_train, y_validate = train_test_split(
    x_train_raw, y_train, test_size=0.10, random_state=42
)

x_val_scaled  = preprocess_input(x_val_raw.copy())
x_test_scaled = preprocess_input(x_test_raw.copy())

print('Train    :', x_train_raw.shape)
print('Validate :', x_val_raw.shape)
print('Test     :', x_test_raw.shape)
print('Val range: [{:.1f}, {:.1f}]'.format(x_val_scaled.min(), x_val_scaled.max()))

## Step 7 — Class Weights
cw = compute_class_weight('balanced', classes=np.unique(y_tr_o), y=y_tr_o)
class_weight_dict = dict(enumerate(cw))
print('Class weights:')
for k, v in class_weight_dict.items():
    print('  [{:d}] {:<35s}: {:.4f}'.format(k, list(lesion_type_dict.values())[k], v))

## Step 8 — tf.data Pipeline with .repeat()
BATCH_SIZE = 32
AUTOTUNE   = tf.data.AUTOTUNE

@tf.function
def augment_fn(image, label):
    image = tf.cast(image, tf.float32)
    image = (image / 127.5) - 1.0          # ResNet50V2 normalization
    image = tf.image.random_flip_left_right(image)
    image = tf.image.random_flip_up_down(image)
    k     = tf.random.uniform([], 0, 4, dtype=tf.int32)
    image = tf.image.rot90(image, k=k)
    image = tf.image.random_brightness(image, max_delta=0.15)
    image = tf.image.random_contrast(image, lower=0.85, upper=1.15)
    image = tf.clip_by_value(image, -1.0, 1.0)
    return image, label

# .repeat() + steps_per_epoch = guaranteed full epoch every time
train_ds = (
    tf.data.Dataset.from_tensor_slices((x_train_raw, y_train))
    .shuffle(buffer_size=len(x_train_raw), seed=42, reshuffle_each_iteration=True)
    .map(augment_fn, num_parallel_calls=AUTOTUNE)
    .batch(BATCH_SIZE)
    .repeat()                               # KEY FIX: never exhausts
    .prefetch(AUTOTUNE)
)

STEPS = len(x_train_raw) // BATCH_SIZE
print('Pipeline ready with .repeat() — no more alternating epoch bug')
print('Steps per epoch :', STEPS)
print('Total train imgs:', len(x_train_raw))

for imgs, labels in train_ds.take(1):
    print('Batch shape     :', imgs.shape)
    print('Pixel range     : [{:.2f}, {:.2f}]'.format(
        float(tf.reduce_min(imgs)), float(tf.reduce_max(imgs))))
print('Pipeline verified OK.')

## Step 9 — Build Model (ResNet50V2)
NUM_CLASSES = 7
INPUT_SHAPE = (IMG_SIZE, IMG_SIZE, 3)

base_model = ResNet50V2(
    weights='imagenet', include_top=False, input_shape=INPUT_SHAPE
)
base_model.trainable = False

# Increased dropout to reduce overfitting (v5 had 8.7% train-val gap)
x      = base_model.output
x      = GlobalAveragePooling2D()(x)
x      = BatchNormalization()(x)
x      = Dropout(0.6)(x)  # increased from 0.5
x      = Dense(512, activation='relu', kernel_regularizer=l2(2e-4))(x)  # stronger L2
x      = BatchNormalization()(x)
x      = Dropout(0.5)(x)  # increased from 0.4
x      = Dense(256, activation='relu', kernel_regularizer=l2(2e-4))(x)
x      = BatchNormalization()(x)
x      = Dropout(0.4)(x)  # increased from 0.3
output = Dense(NUM_CLASSES, activation='softmax')(x)

model = Model(inputs=base_model.input, outputs=output)

total     = int(np.sum([np.prod(w.shape) for w in model.weights]))
trainable = int(np.sum([np.prod(w.shape) for w in model.trainable_weights]))
print('Backbone     : ResNet50V2 (ImageNet)')
print('Dropout      : 0.6 / 0.5 / 0.4  (increased to fight overfitting)')
print('L2 reg       : 2e-4 (stronger than v5)')
print('Total params : {:,}'.format(total))
print('Trainable    : {:,} (head only — Phase 1)'.format(trainable))

## Step 10 — Callbacks
def get_callbacks(path, patience_es=12, patience_lr=5):
    return [
        EarlyStopping(
            monitor='val_accuracy', patience=patience_es,
            restore_best_weights=True, mode='max', verbose=1
        ),
        ReduceLROnPlateau(
            monitor='val_loss', factor=0.5,
            patience=patience_lr, min_lr=1e-9, verbose=1
        ),
        ModelCheckpoint(
            path, monitor='val_accuracy',
            save_best_only=True, mode='max', verbose=1
        )
    ]
print('Callbacks ready.')

## Step 11 — Phase 1: Train Head (30 Epochs)
> All epochs should take equal time now — .repeat() fixes the alternating bug.
model.compile(
    optimizer=Adam(learning_rate=1e-3),
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

print('=' * 60)
print('PHASE 1 — Head only (ResNet50V2 frozen)')
print('Epochs: 30 | LR: 1e-3 | Steps/epoch:', STEPS)
print('All epochs should take same duration with .repeat()')
print('=' * 60)

history1 = model.fit(
    train_ds,
    epochs=30,
    steps_per_epoch=STEPS,
    validation_data=(x_val_scaled, y_validate),
    class_weight=class_weight_dict,
    callbacks=get_callbacks('best_model_p1.keras', patience_es=10, patience_lr=4),
    verbose=1
)

k     = 'val_accuracy' if 'val_accuracy' in history1.history else 'val_acc'
best1 = max(history1.history[k])
print('\nPhase 1 best val_accuracy: {:.2f}%'.format(best1 * 100))

## Step 12 — Phase 2: Fine-Tune (100 Epochs, Patience=15)
> v4 was still improving at epoch 50. Extended to 100 with higher patience.
base_model.trainable = True
freeze_until = int(len(base_model.layers) * 0.4)
for layer in base_model.layers[:freeze_until]:
    layer.trainable = False
for layer in base_model.layers[freeze_until:]:
    layer.trainable = True

trainable = int(np.sum([np.prod(w.shape) for w in model.trainable_weights]))
print('Frozen until layer : {} / {}'.format(freeze_until, len(base_model.layers)))
print('Trainable params   : {:,}'.format(trainable))

model.compile(
    optimizer=Adam(learning_rate=1e-5, weight_decay=1e-4),
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

print('=' * 60)
print('PHASE 2 — Fine-tuning (top 60% of ResNet50V2 unfrozen)')
print('Epochs: 100 | LR: 1e-5 | Steps/epoch:', STEPS)
print('EarlyStopping patience=15 — will stop when truly converged')
print('=' * 60)

history2 = model.fit(
    train_ds,
    epochs=100,
    steps_per_epoch=STEPS,
    validation_data=(x_val_scaled, y_validate),
    class_weight=class_weight_dict,
    callbacks=get_callbacks('best_model.keras', patience_es=15, patience_lr=6),
    verbose=1
)

k     = 'val_accuracy' if 'val_accuracy' in history2.history else 'val_acc'
best2 = max(history2.history[k])
print('\nPhase 2 best val_accuracy: {:.2f}%'.format(best2 * 100))

## Step 13 — Training Curves
def g(h, key):
    alt = key.replace('accuracy','acc').replace('val_accuracy','val_acc')
    return h.history.get(key, h.history.get(alt, []))

acc      = g(history1,'accuracy')     + g(history2,'accuracy')
val_acc  = g(history1,'val_accuracy') + g(history2,'val_accuracy')
loss     = g(history1,'loss')         + g(history2,'loss')
val_loss = g(history1,'val_loss')     + g(history2,'val_loss')
ep       = range(1, len(acc)+1)
p1_end   = len(g(history1,'loss'))

fig, axs = plt.subplots(1, 2, figsize=(15, 5))
for ax, tv, vv, title in zip(axs,
    [acc, loss], [val_acc, val_loss], ['Accuracy','Loss']):
    ax.plot(ep, tv, label='Train',      color='#2196F3')
    ax.plot(ep, vv, label='Validation', color='#4CAF50')
    ax.axvline(p1_end, color='gray', linestyle='--', linewidth=1.5, label='Phase 2 start')
    ax.set_title(title); ax.set_xlabel('Epoch')
    ax.legend(); ax.grid(alpha=0.3)
plt.suptitle('Training History — Phase 1 + Phase 2', fontsize=13, fontweight='bold')
plt.tight_layout()
plt.savefig('training_curves.png', dpi=150)
plt.show()

## Step 14 — Final Evaluation
_, acc_v = model.evaluate(x_val_scaled,  y_validate, verbose=0)
_, acc_t = model.evaluate(x_test_scaled, y_test,     verbose=0)

print('\n' + '=' * 60)
print('FINAL RESULTS')
print('=' * 60)
print('Validation Accuracy : {:.2f}%'.format(acc_v * 100))
print('Test Accuracy       : {:.2f}%'.format(acc_t * 100))
print('=' * 60)
if acc_t >= 0.90:
    print('TARGET MET: Above 90%!')
elif acc_t >= 0.85:
    print('Close to target — above 85%')
else:
    print('Share logs — will diagnose further.')

## Step 15 — Confusion Matrix
Y_pred   = model.predict(x_val_scaled, verbose=0)
Y_pred_c = np.argmax(Y_pred,    axis=1)
Y_true   = np.argmax(y_validate, axis=1)

class_labels = list(lesion_type_dict.values())
cm      = confusion_matrix(Y_true, Y_pred_c)
cm_norm = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]

fig, axes = plt.subplots(1, 2, figsize=(20, 8))
for ax, data, fmt, title in zip(
    axes, [cm, cm_norm], ['d','.2f'],
    ['Confusion Matrix (Counts)','Confusion Matrix (Normalized)']):
    im = ax.imshow(data, interpolation='nearest', cmap=plt.cm.Blues)
    ax.set_title(title, fontsize=12); plt.colorbar(im, ax=ax)
    ticks = np.arange(len(class_labels))
    ax.set_xticks(ticks); ax.set_xticklabels(class_labels, rotation=40, ha='right', fontsize=8)
    ax.set_yticks(ticks); ax.set_yticklabels(class_labels, fontsize=8)
    thresh = data.max() / 2.
    for i, j in itertools.product(range(data.shape[0]), range(data.shape[1])):
        ax.text(j, i, format(data[i,j], fmt), ha='center',
                color='white' if data[i,j] > thresh else 'black', fontsize=8)
    ax.set_ylabel('True'); ax.set_xlabel('Predicted')
plt.tight_layout()
plt.savefig('confusion_matrix.png', dpi=150)
plt.show()

## Step 16 — Classification Report
print(classification_report(Y_true, Y_pred_c, target_names=class_labels, digits=4))

err = 1 - np.diag(cm) / np.sum(cm, axis=1)
colors_b = ['#e74c3c' if e > 0.2 else '#f39c12' if e > 0.1 else '#2ecc71' for e in err]
plt.figure(figsize=(11, 4))
bars = plt.bar(class_labels, err, color=colors_b, edgecolor='white')
plt.xticks(rotation=30, ha='right')
plt.ylabel('Fraction Misclassified')
plt.title('Per-Class Error Rate (Red>20%, Orange>10%, Green<=10%)')
for bar, val in zip(bars, err):
    plt.text(bar.get_x()+bar.get_width()/2, bar.get_height()+0.005,
             '{:.1%}'.format(val), ha='center', fontsize=9)
plt.tight_layout()
plt.savefig('per_class_error.png', dpi=150)
plt.show()

